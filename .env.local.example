# Supabase — obtener en Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Solo server-side — NUNCA exponer con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sitio
NEXT_PUBLIC_SITE_URL=https://congresomedfam2026.mx

# Resend — Correo de confirmación de inscripción (solo server-side)
# API Key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remitente verificado en Resend. Si se omite en desarrollo, se usa
# automáticamente el remitente de pruebas de Resend (onboarding@resend.dev,
# que solo puede enviar a la cuenta registrada). En producción es
# obligatoria — sin ella, el envío se rechaza con un error explícito.
RESEND_FROM_EMAIL=XXV Congreso Regional Noreste de Medicina Familiar <confirmaciones@congresomedicinafamiliar.com>
